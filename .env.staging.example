# Disposable local integration infrastructure (docker-compose.staging.yml).
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://chatflow_test:local_test_only@127.0.0.1:55432/chatflow_security_test
TEST_DATABASE_URL=postgres://chatflow_test:local_test_only@127.0.0.1:55432/chatflow_security_test
TEST_DATABASE_CONFIRM=I_CONFIRM_DISPOSABLE_TEST_DATABASE
STAGING_REDIS_URL=redis://127.0.0.1:56379/0
REDIS_URL=redis://127.0.0.1:56379/0

# Set this only in an isolated local/staging runtime after migrations and checks.
CHATFLOW_ENVIRONMENT=isolated-staging
AGENT_WEBSITE_ENABLED=false
ACCOUNT_AUTH_ENABLED=true
ACCOUNT_AUTH_URL=http://127.0.0.1:3000
ACCOUNT_AUTH_SECRET=replace-with-a-random-local-secret-at-least-32-characters
ACCOUNT_TRUSTED_ORIGINS=http://127.0.0.1:3000
ACCOUNT_PROXY_MODE=direct
TRUSTED_PROXY_CIDRS=
DASHBOARD_ALLOWED_ORIGINS=http://127.0.0.1:3000
WIDGET_ALLOWED_ORIGINS=
RESEND_API_KEY=replace-with-approved-test-email-provider-key
RESEND_FROM_EMAIL=staging@example.invalid
RESEND_FROM_NAME=Chatflow Staging

# Mock-based tests need no provider credentials. The optional provider canary
# requires explicit approval and one provider key; never put real values here.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LIVE_PROVIDER_TEST_APPROVED=
LIVE_PROVIDER_MODEL=
LIVE_PROVIDER=openai
LIVE_PROVIDER_MAX_COST_USD=
LIVE_PROVIDER_INPUT_USD_PER_1M=
LIVE_PROVIDER_OUTPUT_USD_PER_1M=
LIVE_PROVIDER_EMBEDDING_USD_PER_1M=

# Legacy/admin services are not exercised by the isolated agent fixture.
ADMIN_API_KEY=local-only-placeholder
JWT_SECRET=local-only-placeholder
